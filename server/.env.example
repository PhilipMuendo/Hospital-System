DATABASE_URL="postgresql://uzima_app:uzima_dev_pw@127.0.0.1:5432/uzima_hms"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
NODE_ENV=development

# Browser origins allowed to send credentialed requests. Comma-separated.
# Defaults to the Vite dev server in development; in production an empty list
# means no cross-origin browser access at all, which is the right default when
# the SPA is served from the same origin as the API.
CORS_ORIGINS="http://localhost:5173"

# --- M-Pesa (Safaricom Daraja) -------------------------------------------
#
# Leave MPESA_CONSUMER_KEY/SECRET empty to run in mock mode: STK pushes are
# accepted and can be completed locally via POST /api/mpesa/mock/complete/:id,
# so the billing flow works end to end without a Safaricom account. Mock mode
# refuses to start when NODE_ENV=production.
#
# For real payments, create an app at https://developer.safaricom.co.ke.
MPESA_MOCK=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# 174379 is the Daraja sandbox paybill. Replace with the facility's own.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Must be a publicly reachable HTTPS URL — Safaricom posts the result here.
# In production, restrict this path to Safaricom's published IP ranges at the
# reverse proxy: the endpoint is necessarily unauthenticated.
MPESA_CALLBACK_URL="https://example.co.ke/api/mpesa/callback"
