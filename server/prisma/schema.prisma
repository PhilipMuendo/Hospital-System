generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PHYSICIAN
  NURSE
  BILLING
  PHARMACIST
}

enum Sex {
  MALE
  FEMALE
  INTERSEX
}

enum CodeStatus {
  FULL_CODE
  DNR
  DNI
  COMFORT_CARE
}

enum PatientStatus {
  // Known to the facility, not currently an inpatient. The default: most
  // people who walk through the door are never admitted.
  REGISTERED
  ADMITTED
  DISCHARGED
}

enum Severity {
  HEALTHY
  WARNING
  CRITICAL
}

enum LabFlag {
  NORMAL
  LOW
  HIGH
}

enum BillingStatus {
  PAID
  PENDING
  DENIED
}

enum Payer {
  SHA
  IMARA_HEALTH_ASSURANCE
  SELF_PAY
}

enum ORRoom {
  OR_1
  OR_2
  OR_3
  OR_4
}

enum SurgeryStatus {
  CONFIRMED
  IN_PROGRESS
  DELAYED
  CANCELLED
}

// --- Audit (Kenya Data Protection Act 2019 — processing & access log) ---

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  DENIED
}

// --- M-Pesa (Safaricom Daraja) ---

enum MpesaStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

// --- Pharmacy ---

enum DrugForm {
  TABLET
  CAPSULE
  SYRUP
  SUSPENSION
  INJECTION
  INFUSION
  SUPPOSITORY
  TOPICAL
  INHALER
  DROPS
}

enum PrescriptionStatus {
  ACTIVE
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  DISPENSE
  ADJUSTMENT
  EXPIRY_WRITE_OFF
  RETURN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  primaryPatients     Patient[]     @relation("PrimaryPhysician")
  surgeriesAsSurgeon  Surgery[]     @relation("Surgeon")
  billingLinesCreated BillingLine[] @relation("BillingCreatedBy")
  labsReviewed        LabResult[]   @relation("LabReviewedBy")
  alertsResolved      Alert[]       @relation("AlertResolvedBy")

  auditLogs            AuditLog[]         @relation("AuditActor")
  prescriptionsWritten Prescription[]     @relation("Prescriber")
  dispensesMade        DispenseEvent[]    @relation("DispensedBy")
  stockMovementsMade   StockMovement[]    @relation("StockMovementBy")
  mpesaInitiated       MpesaTransaction[] @relation("MpesaInitiatedBy")
}

model Ward {
  id          String @id @default(cuid())
  name        String @unique
  bedCapacity Int

  patients Patient[]
  alerts   Alert[]
  devices  Device[]
}

model Patient {
  id                String     @id @default(cuid())
  // Issued once, on first ever contact with the facility.
  opNumber          String?    @unique
  // Issued only on admission, so null for everyone who is seen and goes home.
  ipNumber          String?    @unique
  nationalId        String?    @unique
  name              String
  dob               DateTime
  sex               Sex
  bloodType         String
  phone             String?
  nextOfKinName     String
  nextOfKinPhone    String
  nextOfKinRelation String
  allergies         String[]   @default([])
  codeStatus        CodeStatus @default(FULL_CODE)
  chiefComplaint    String?
  assessment        String?
  carePlan          String[]   @default([])
  avatarInitials    String

  wardId String?
  ward   Ward?   @relation(fields: [wardId], references: [id])
  bed    String?

  primaryPhysicianId String?
  primaryPhysician   User?   @relation("PrimaryPhysician", fields: [primaryPhysicianId], references: [id])

  status       PatientStatus @default(REGISTERED)
  registeredAt DateTime      @default(now())
  admittedAt   DateTime?
  dischargedAt DateTime?

  vitals            VitalReading[]
  labs              LabResult[]
  imaging           ImagingStudy[]
  billingLines      BillingLine[]
  surgeries         Surgery[]
  prescriptions     Prescription[]
  mpesaTransactions MpesaTransaction[]
  auditLogs         AuditLog[]
  visits            Visit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VitalReading {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  label      String
  value      String
  unit       String
  status     Severity
  recordedAt DateTime @default(now())

  @@index([patientId, recordedAt])
}

model LabResult {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  test         String
  result       String
  range        String
  flag         LabFlag
  collectedAt  DateTime
  reviewed     Boolean   @default(false)
  reviewedById String?
  reviewedBy   User?     @relation("LabReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  @@index([patientId])
}

model ImagingStudy {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  study           String
  modality        String
  performedAt     DateTime
  radiologistName String
  impression      String

  @@index([patientId])
}

model BillingLine {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  description    String
  code           String
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("KES")
  payer          Payer
  status         BillingStatus @default(PENDING)
  mpesaReference String?
  createdById    String
  createdBy      User          @relation("BillingCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  mpesaTransactions MpesaTransaction[]
  dispenseEvent     DispenseEvent?

  @@index([patientId])
  @@index([status])
}

model Surgery {
  id        String        @id @default(cuid())
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedure String
  surgeonId String
  surgeon   User          @relation("Surgeon", fields: [surgeonId], references: [id])
  room      ORRoom
  startsAt  DateTime
  endsAt    DateTime
  status    SurgeryStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())

  @@index([room, startsAt, endsAt])
}

model Alert {
  id           String    @id @default(cuid())
  severity     Severity
  message      String
  wardId       String?
  ward         Ward?     @relation(fields: [wardId], references: [id])
  resolved     Boolean   @default(false)
  resolvedById String?
  resolvedBy   User?     @relation("AlertResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

// Stand-in for the handful of dashboard KPIs with no natural backing
// event log in this scope (e.g. Casualty wait time isn't derived from a
// triage-timestamp system). Avg. Length of Stay and Discharges Today are
// computed live from Patient rows instead of stored here.
model HospitalMetric {
  key   String @id
  label String
  value String
  delta String
  trend String
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

// Append-only. Every authenticated mutation and every read of patient-level
// PHI lands here, so the facility can answer "who looked at this chart, and
// when" — a standing requirement under the Data Protection Act 2019 and the
// Health Act 2017 confidentiality provisions. Rows are never updated or
// deleted by application code.
model AuditLog {
  id String @id @default(cuid())

  actorId   String?
  actor     User?   @relation("AuditActor", fields: [actorId], references: [id])
  actorRole Role?
  // Retained verbatim so the log still reads correctly after a user is renamed
  // or deactivated.
  actorLabel String

  action AuditAction
  entity String
  entityId String?

  // Denormalised so a subject-access request ("show me everyone who touched
  // this patient") is one indexed query rather than a scan over meta.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  method String?
  path   String
  status Int?

  ip        String?
  userAgent String?

  // Field-level before/after for mutations; query shape for reads. Never
  // holds credentials — the writer strips them.
  meta Json?

  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// M-Pesa — Safaricom Daraja Lipa na M-Pesa Online (STK Push)
// ---------------------------------------------------------------------------

model MpesaTransaction {
  id String @id @default(cuid())

  billingLineId String?
  billingLine   BillingLine? @relation(fields: [billingLineId], references: [id], onDelete: SetNull)

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  // Normalised to 2547XXXXXXXX / 2541XXXXXXXX before it leaves the server.
  phone            String
  // Daraja rejects fractional amounts on the paybill product, so this is whole
  // shillings even though BillingLine.amount carries cents.
  amount           Decimal @db.Decimal(10, 2)
  accountReference String
  description      String

  merchantRequestId String?
  checkoutRequestId String? @unique

  status     MpesaStatus @default(PENDING)
  resultCode String?
  resultDesc String?

  mpesaReceiptNumber String?
  transactionDate    DateTime?

  // Whole Daraja envelopes, kept for reconciliation against the Safaricom
  // statement and for dispute resolution.
  requestPayload  Json?
  callbackPayload Json?

  initiatedById String?
  initiatedBy   User?   @relation("MpesaInitiatedBy", fields: [initiatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billingLineId])
  @@index([patientId])
  @@index([status, createdAt])
  @@index([mpesaReceiptNumber])
}

// ---------------------------------------------------------------------------
// Pharmacy — formulary, batch stock, prescribing, dispensing
// ---------------------------------------------------------------------------

model Drug {
  id String @id @default(cuid())

  // Facility formulary code, e.g. "PHARM-118".
  code         String   @unique
  genericName  String
  brandName    String?
  form         DrugForm
  strength     String
  unit         String   @default("unit")

  // KEML = Kenya Essential Medicines List. Flagged because SHA benefit rules
  // and county stock-out reporting both key off it.
  kemlListed   Boolean @default(false)
  controlled   Boolean @default(false)

  unitPrice Decimal @db.Decimal(10, 2)
  currency  String  @default("KES")

  reorderLevel Int     @default(0)
  active       Boolean @default(true)

  batches           DrugBatch[]
  prescriptionItems PrescriptionItem[]
  stockMovements    StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([genericName])
  @@index([active])
}

model DrugBatch {
  id String @id @default(cuid())

  drugId String
  drug   Drug   @relation(fields: [drugId], references: [id], onDelete: Cascade)

  batchNumber String
  expiryDate  DateTime
  // Decremented under a transaction on dispense; never allowed below zero.
  quantity    Int
  supplier    String?
  receivedAt  DateTime @default(now())

  stockMovements StockMovement[]

  @@unique([drugId, batchNumber])
  @@index([drugId, expiryDate])
}

model StockMovement {
  id String @id @default(cuid())

  drugId String
  drug   Drug   @relation(fields: [drugId], references: [id], onDelete: Cascade)

  batchId String?
  batch   DrugBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  type StockMovementType
  // Signed: negative for dispense and write-off, positive for receipt.
  quantity Int
  // Batch quantity after this movement, so the ledger can be replayed and
  // reconciled without recomputing from every prior row.
  balanceAfter Int?

  reason String?

  performedById String?
  performedBy   User?   @relation("StockMovementBy", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([drugId, createdAt])
  @@index([batchId])
  @@index([type, createdAt])
}

model Prescription {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  prescriberId String
  prescriber   User   @relation("Prescriber", fields: [prescriberId], references: [id])

  status PrescriptionStatus @default(ACTIVE)
  notes  String?

  // Set when the prescriber overrode a recorded allergy match; the reason is
  // required by the API and is what the audit log points at.
  allergyOverrideReason String?

  items PrescriptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
  @@index([status])
}

model PrescriptionItem {
  id String @id @default(cuid())

  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  drugId String
  drug   Drug   @relation(fields: [drugId], references: [id])

  dose      String
  route     String
  frequency String
  durationDays Int?

  quantityPrescribed Int
  quantityDispensed  Int @default(0)

  instructions String?

  dispenseEvents DispenseEvent[]

  @@index([prescriptionId])
  @@index([drugId])
}

model DispenseEvent {
  id String @id @default(cuid())

  prescriptionItemId String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)

  // Which batches were drawn down, in FEFO order.
  batchBreakdown Json

  quantity Int

  dispensedById String
  dispensedBy   User   @relation("DispensedBy", fields: [dispensedById], references: [id])

  // The charge raised for this dispense. One-to-one: re-dispensing creates a
  // new event and a new line rather than mutating the old charge.
  billingLineId String?      @unique
  billingLine   BillingLine? @relation(fields: [billingLineId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([prescriptionItemId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Biomedical devices
// ---------------------------------------------------------------------------

enum DeviceKind {
  PATIENT_MONITOR
  INFUSION_PUMP
  VENTILATOR
  LAB_ANALYSER
  ECG
  ULTRASOUND
  XRAY
  DEFIBRILLATOR
  PULSE_OXIMETER
  WEIGHING_SCALE
  BARCODE_SCANNER
  THERMOMETER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  FAULT
  RETIRED
}

// How readings physically reach us. Not cosmetic — it decides which ingest
// path a device uses and what can be expected of it.
enum DeviceTransport {
  // HL7 v2 over MLLP/TCP. The workhorse for monitors and lab analysers.
  HL7_MLLP
  // Vendor pushes JSON to our REST endpoint with a device key.
  REST_PUSH
  // Plugged into the workstation, read in-browser via WebSerial/WebHID.
  SERIAL_BRIDGE
  // No integration: a human reads the display and types it in.
  MANUAL
}

model Device {
  id String @id @default(cuid())

  // Facility asset tag, the number physically stickered on the unit.
  assetTag     String  @unique
  name         String
  kind         DeviceKind
  manufacturer String?
  model        String?
  serialNumber String?

  transport DeviceTransport @default(MANUAL)
  status    DeviceStatus    @default(OFFLINE)

  // Where it lives. A monitor is normally bound to a bed; an analyser to a room.
  wardId String?
  ward   Ward?   @relation(fields: [wardId], references: [id])
  bed    String?

  // The application identifier this device puts in MSH-3, used to match an
  // inbound HL7 message back to the asset register.
  hl7SendingApplication String? @unique
  ipAddress             String?

  // Shared secret for REST_PUSH devices. Hashed, never returned by the API.
  apiKeyHash String?

  lastSeenAt DateTime?

  // Biomedical engineering: statutory calibration and service intervals.
  commissionedAt DateTime?
  lastServicedAt DateTime?
  serviceDueAt   DateTime?
  calibrationDueAt DateTime?

  notes String?

  messages DeviceMessage[]
  readings DeviceReading[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status])
  @@index([wardId])
  @@index([serviceDueAt])
}

// Raw inbound traffic, kept before parsing. When a monitor sends something we
// cannot understand, this is the only way to find out what it actually said.
model DeviceMessage {
  id String @id @default(cuid())

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  transport DeviceTransport
  // Verbatim payload, segment separators intact.
  raw       String
  messageType String?
  controlId   String?

  parsed    Boolean @default(false)
  parseError String?

  // Set once the message has been matched to a patient.
  patientId String?

  sourceIp  String?
  receivedAt DateTime @default(now())

  @@index([deviceId, receivedAt])
  @@index([parsed, receivedAt])
}

// A single observation from a device, before a clinician accepts it.
//
// Device output is NOT written straight into the chart: an unattended monitor
// produces artefact constantly — a lead falls off and it reports asystole. A
// reading is staged here and a nurse confirms it into VitalReading.
model DeviceReading {
  id String @id @default(cuid())

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  patientId String?

  // OBX-3 observation identifier, e.g. "MDC_PULS_OXIM_SAT_O2".
  code  String
  label String
  value String
  unit  String
  // OBX-8 abnormal flag as sent by the device.
  abnormalFlag String?

  measuredAt DateTime
  receivedAt DateTime @default(now())

  accepted     Boolean   @default(false)
  acceptedById String?
  acceptedAt   DateTime?
  rejectedReason String?

  @@index([deviceId, measuredAt])
  @@index([patientId, measuredAt])
  @@index([accepted, receivedAt])
}

// ---------------------------------------------------------------------------
// Outpatient visits and the queue
// ---------------------------------------------------------------------------

enum VisitType {
  NEW
  REVISIT
  FOLLOW_UP
  EMERGENCY
}

enum VisitStatus {
  OPEN
  COMPLETED
  // The visit ended in an admission; the inpatient record takes over.
  ADMITTED
  // Left without being seen. Tracked deliberately: LWBS rate is the single
  // most honest measure of whether the queue is working.
  LWBS
  CANCELLED
}

// South African Triage Scale, which is what Kenyan casualty units actually
// use. Target times are the SATS standards and drive the queue order.
enum TriageAcuity {
  RED // immediate
  ORANGE // < 10 minutes
  YELLOW // < 60 minutes
  GREEN // < 240 minutes
  BLUE // dead on arrival
}

enum StationKind {
  RECEPTION
  TRIAGE
  CASHIER
  CONSULTATION
  LAB
  IMAGING
  PHARMACY
}

enum TicketStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  // Called the maximum number of times without appearing.
  NO_SHOW
  CANCELLED
}

// A physical place a patient queues for: a reception desk, the triage room,
// consultation room 3.
model Station {
  id String @id @default(cuid())

  code String @unique
  name String
  kind StationKind
  room String?

  // Prefix on the printed token, e.g. "C" gives C-042. Kept short so it is
  // readable across a waiting room.
  tokenPrefix String

  // Sensitive services (e.g. an HIV or TB clinic) never render a name on the
  // public board, only the token.
  privateClinic Boolean @default(false)

  active Boolean @default(true)

  tickets QueueTicket[]
  visits  Visit[]

  createdAt DateTime @default(now())

  @@index([kind, active])
}

model Visit {
  id String @id @default(cuid())

  // Human-facing attendance number, e.g. OPD/2026/08/0042.
  visitNumber String @unique

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  type   VisitType   @default(REVISIT)
  status VisitStatus @default(OPEN)

  chiefComplaint String?

  payer     Payer   @default(SELF_PAY)
  shaNumber String?

  // Set at triage. Null means not yet triaged, which the queue treats as
  // routine — never as "no priority".
  acuity TriageAcuity?

  // Where the patient is now, for the "where is my patient" question.
  currentStationId String?
  currentStation   Station? @relation(fields: [currentStationId], references: [id])

  arrivedAt DateTime  @default(now())
  closedAt  DateTime?

  registeredById String?
  outcome        String?

  tickets QueueTicket[]
  triage  TriageAssessment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, arrivedAt])
  @@index([patientId, arrivedAt])
  @@index([currentStationId])
}

model QueueTicket {
  id String @id @default(cuid())

  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  stationId String
  station   Station @relation(fields: [stationId], references: [id])

  // Sequence within this station for this service day, and the token shown to
  // the patient. Both reset at midnight Nairobi.
  number Int
  token  String
  // Stored as YYYY-MM-DD in Nairobi so "today" is a plain equality check and
  // never drifts with the server's timezone.
  serviceDate String

  // Derived from acuity at issue time; lower is seen sooner. Stored rather
  // than computed so the ordering is auditable after the fact.
  priority Int @default(3)

  status TicketStatus @default(WAITING)

  issuedAt    DateTime  @default(now())
  calledAt    DateTime?
  servedAt    DateTime?
  completedAt DateTime?

  // A patient who does not appear is called again, not discarded. Three
  // strikes before NO_SHOW.
  callCount Int @default(0)

  calledById String?
  servedById String?
  // Which desk or room to go to, shown on the board.
  counter String?

  @@unique([stationId, serviceDate, number])
  @@index([stationId, status, priority, issuedAt])
  @@index([serviceDate, status])
  @@index([visitId])
}

model TriageAssessment {
  id String @id @default(cuid())

  visitId String @unique
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  acuity TriageAcuity

  // Recorded here as well as on the chart, because the triage observation is
  // the justification for the acuity and must not be edited later.
  temperature   String?
  pulse         String?
  respiratory   String?
  bloodPressure String?
  spo2          String?
  weightKg      String?
  heightCm      String?

  notes String?

  performedById String
  performedAt   DateTime @default(now())

  @@index([acuity, performedAt])
}

/// Atomic sequence allocator.
///
/// Ticket numbers and visit numbers were previously derived by reading the
/// current maximum and adding one. Under READ COMMITTED two concurrent
/// check-ins read the same maximum and then collide on the unique index, so a
/// reception desk with two clerks failed roughly half the time.
///
/// A single-statement upsert-and-increment serialises on the row instead, so
/// concurrent callers queue behind each other and every one gets a distinct
/// number.
model Counter {
  /// e.g. "ticket:<stationId>:2026-08-20" or "visit:2026-08".
  key   String @id
  value Int    @default(0)
}
